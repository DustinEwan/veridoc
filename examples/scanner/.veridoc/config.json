{
  "protocol": "vd/1",
  "plugin": { "name": "veridoc-plugin-ts" },
  "coverage": { "required": 0.6 },
  "run": { "scenarioDeadlineMs": 30000 },
  "judge": {
    "transport": "command",
    "command": ["node", "tools/scripted-judge.mjs"],
    "model": "scripted-1"
  },
  "output": { "dir": ".veridoc/out", "formatters": ["markdown"] },
  "citationStores": [{ "name": "session", "kind": "file", "path": ".veridoc/citations" }]
}
